{"nodes": [{"id": "docs_plan", "label": "Plan: orientation-aware training + LoRA/EMA + SD fusion on branch sd", "file_type": "document", "source_file": "docs/PLAN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remaining v2 errors are near misses (16%) and left/right wrong-keypoint mix-ups (10%); target orientation without SD first, then a cheap frozen SD gate, then fusion only if it passes."}, {"id": "docs_plan_marginal_loss", "label": "Marginal loss", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_pair_batch", "label": "Pair-batched training", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One backbone pass supervises ~6 queries; required for hard negatives."}, {"id": "docs_plan_hard_negatives", "label": "Hard negatives from other queries of the pair", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "+log(weight) on logits of cells near other queries' targets, minus exclusion zone; risk of label noise when another part is a valid unlisted match."}, {"id": "docs_plan_lora", "label": "Hand-written LoRA (query/value, last N blocks)", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "B initialised at zero so update 0 = frozen DINOv2; hand-written to avoid peft dependency."}, {"id": "docs_plan_ema", "label": "EMA of trainable weights", "file_type": "rationale", "source_file": "docs/PLAN.md", "source_location": "L37", "source_url": null, "captured_at": null, "author": null, "contributor": null},